{
  "name": "shift-master-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build && node scripts/prepare-holiday-api.mjs",
    "preview": "serve out -l 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "holidays:update": "node scripts/update-japanese-holidays.mjs",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\""
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10",
    "eslint-plugin-prettier": "^5",
    "prettier": "^3",
    "serve": "^14",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
